# 复制为 .env 后填写。没有 LLM key 也能用（AI 纠错/生成笔记不可用，其余功能正常）。

TRANSCRIPT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRANSCRIPT_LLM_API_KEY=sk-你的key
TRANSCRIPT_LLM_MODEL=qwen3.8-27b
TRANSCRIPT_LLM_TIMEOUT=120

# 领域术语表（逗号分隔，对 AI 纠错效果影响最大，按你的领域改）
TRANSCRIPT_LLM_GLOSSARY=射击,射程,弹头,尾锥,圆柱部,弧形部,力矩,弹着点

# —— 以下全部有合理默认值，按需修改 ——

# 历史记录保留条数（更早的连本地预览视频一起删；0=不限制）
#TRANSCRIPT_HISTORY_KEEP=20

# —— 接口认证（可选）——
# 本机页面会自动下发 HttpOnly + SameSite=Strict Cookie，无需配置 Token。
# 外部脚本 / Halo 插件调用 /prod-api/* 时设置 Token，并带
# Authorization: Bearer <token> 或 X-API-Token: <token>。
#TRANSCRIPT_API_TOKEN=
# Host 白名单；局域网 IP、容器名或反向代理访问时需要加入
#TRANSCRIPT_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# 浏览器跨域来源白名单（逗号分隔）；Halo 服务端代理调用不需要
#TRANSCRIPT_ALLOWED_ORIGINS=

# GPU：显存小或无显卡设 1 强制 CPU
#TRANSCRIPT_FORCE_CPU=0
# 同时缓存的 whisper 模型个数（显存 6GB 建议 2）
#TRANSCRIPT_MODEL_CACHE=2
# 批处理推理：吞吐高 3 倍，但**实测会成段丢内容**（5 分钟片段丢 16.5%，
# 含 114 字的整段剧情；另引入少量幻觉词）。**不推荐开启**，除非你能接受漏内容。
#TRANSCRIPT_ASR_BATCH=0
# 「自动」转写模型的时长分界（秒，2026-11-05 基准 = 4 分钟）：视频号贴链接等
# 入口选「自动」时，≤该值用 medium（更准），超过用 tiny（更快）
#TRANSCRIPT_AUTO_MEDIUM_MAX_SEC=240

# —— 代理与出口（现在的默认是"直连"；要买代理时看这里）——
# 出口池：逗号分隔，多个出口会**按账号稳定绑定 + 匿名轮询**。优先级：平台池 > 全局池 > 单条
#TRANSCRIPT_PROXY_POOL=
# 单平台池（示例：抖音 3 条、快手 2 条）
#TRANSCRIPT_PROXY_POOL_DOUYIN=
#TRANSCRIPT_PROXY_POOL_KUAISHOU=
# 单条代理（等效于只有一条的池）
#TRANSCRIPT_PROXY=
#TRANSCRIPT_PROXY_DOUYIN=
# 媒体（视频/音频/图片）单独一条出口；**留空 = 直连，省流量**，按流量计费务必留空
#TRANSCRIPT_PROXY_MEDIA=
# 出口自检：页面可点，或直接 GET /prod-api/proxy/check

# —— 账号池 ——
# 号文件约定：cookies/<平台>/account_1.txt、account_2.txt…（Netscape 格式）
# 单号回退到 cookies/<平台>.txt；登录用 python login_cookie.py douyin --account account_1
# Cookie 策略：off(从不带) / fallback(匿名优先，只有需要登录态才用号) / always(每次都用)
# 2026-11-03 更正：曾一度改为 always，**方向反了** —— 当时判断「匿名被拦」，
#   实测证明那次被拦是 profile 脏（旧 profile 被标记），不是匿名的问题。
#   而 always 会让每个请求都带上**已被平台标记的账号**，平台每次都直接甩验证码。
#   实测（11-03）：同 IP、同全新 profile，匿名成功、带 cookie 被拦 —— 病根在账号。
TRANSCRIPT_COOKIE_MODE=fallback
#TRANSCRIPT_COOKIE_DIR=cookies

# —— 每日额度 ——
# 全局默认 200；平台默认：抖音 150 / 快手 200 / 小红书 100 / B站 200
#TRANSCRIPT_DAILY_BUDGET=200
#TRANSCRIPT_DOUYIN_DAILY_BUDGET=150
#TRANSCRIPT_KUAISHOU_DAILY_BUDGET=200

# —— 队列（持久化，服务重启后自动续跑）——
#TRANSCRIPT_QUEUE_MAX=100
#TRANSCRIPT_QUEUE_FILE=queue_state.json

# —— 抖音/快手风控 ——
# 平台级串行锁始终开启；冷却默认开启，不建议关闭
#TRANSCRIPT_RISK_COOLDOWN=1
#TRANSCRIPT_DOUYIN_COOLDOWN=1
#TRANSCRIPT_KUAISHOU_COOLDOWN=1
# 同域名抓取最小间隔（毫秒，默认 2000）
#TRANSCRIPT_THROTTLE_MIN_MS=2000
# 平台级最小间隔（毫秒，默认 3000；同平台所有请求共用一条节奏）
#TRANSCRIPT_PLATFORM_MIN_MS=3000
# 抖动比例（默认 0.5：在 0~50% 范围内随机加时，避免固定节奏被识别）
#TRANSCRIPT_THROTTLE_JITTER=0.5
# 批量逐条间隔（秒，默认 3）
#TRANSCRIPT_BATCH_DELAY=3

# —— 画面文字 OCR（硬字幕/花字；抖音/快手/小红书默认开）——
# 探针帧数：先扫这几帧，没文字就跳过全扫（默认 8；觉得漏字可调大）
#TRANSCRIPT_FRAME_OCR_PROBE=8
# 可疑/无害画面文字是否只记日志不写结果（0=关闭静默）
#TRANSCRIPT_IMAGE_OCR_QUIET=5
# 小红书图文按需 OCR：先认几张、上限几张、够多少字就停
#TRANSCRIPT_IMAGE_OCR_FIRST=3
#TRANSCRIPT_IMAGE_OCR_MAX=20
#TRANSCRIPT_IMAGE_OCR_MIN_CHARS=60
# 平台只给 HLS 时是否下载一份 mp4 供预览（1=开，0=省流量）
#TRANSCRIPT_HLS_PREVIEW=1

# —— 保留策略与磁盘 ——
# 按天保留（0=不按天）；媒体文件单独按天清理（只删大文件，记录与文案保留）
#TRANSCRIPT_HISTORY_KEEP_DAYS=0
#TRANSCRIPT_MEDIA_KEEP_DAYS=14
#TRANSCRIPT_TASKS_DIR=tasks
#TRANSCRIPT_ARCHIVE_DIR=

# —— 监听目录（把手头视频/图片放进文件夹 → 自动转写；一批图片 = 一条文案）——
#TRANSCRIPT_WATCH_DIR=
#TRANSCRIPT_WATCH_MODEL=medium
#TRANSCRIPT_WATCH_INTERVAL=5
#TRANSCRIPT_WATCH_MOVE=1
#TRANSCRIPT_WATCH_FRAME_OCR=1
# 去重记录文件（避免同一文件重复转写）
#TRANSCRIPT_WATCH_DEDUPE_FILE=watch_dedupe.json
# processed/ 里的原片按天自动清理（**默认 0 = 不清理**；视频号原片是素材，工具不替你删）
#TRANSCRIPT_WATCH_KEEP_DAYS=0
# 转写完成时弹一次桌面气泡（1=开，默认开；**不受静默时段限制**——夜里下完也该知道成没成）
#TRANSCRIPT_WATCH_NOTIFY=1
# 想让"完成通知"也遵守静默时段就设 1
#TRANSCRIPT_WATCH_NOTIFY_QUIET=0

# —— 告警（本地日志 + 页面横幅；需要外推再配）——
# 巡检间隔秒（默认 300；0=关闭巡检）
#TRANSCRIPT_ALERT_INTERVAL=300
# 失败率阈值 / 统计窗口 / 最少样本数 / 队列积压阈值 / 磁盘告警线(GB)
#TRANSCRIPT_ALERT_FAIL_RATE=0.5
#TRANSCRIPT_ALERT_TASKS=20
#TRANSCRIPT_ALERT_MIN_TASKS=5
#TRANSCRIPT_ALERT_QUEUE=20
#TRANSCRIPT_ALERT_DISK_GB=2.0
# 桌面气泡通知（1=开）
#TRANSCRIPT_ALERT_NOTIFY=1
# 自定义 webhook（默认体兼容企业微信/钉钉；{msg} 会被替换）
#TRANSCRIPT_ALERT_WEBHOOK=
#TRANSCRIPT_ALERT_WEBHOOK_BODY=
# 告警推送到微信（Server酱 SendKey；留空=不推送）
TRANSCRIPT_ALERT_SERVERCHAN_KEY=

# —— LLM 备用（主模型不可用时自动降级；各家 OpenAI 兼容端点都行）——
#TRANSCRIPT_LLM_FALLBACK_BASE_URL=
#TRANSCRIPT_LLM_FALLBACK_API_KEY=
#TRANSCRIPT_LLM_FALLBACK_MODEL=
# 思考链开关：纠错建议 off（讯飞 spark-x2.6 必须 off，否则正文为空）
#TRANSCRIPT_LLM_THINKING=off
#TRANSCRIPT_LLM_THINKING_NOTE=
# 纠错分块字数 / 并发路数
#TRANSCRIPT_CORRECT_CHUNK=250
#TRANSCRIPT_CORRECT_WORKERS=4
# —— 账号接入（多账号跑量时）——
# 每账号每日上限（0=不限，默认 30）：到达上限的号当天不再被挑中；全都到上限会临时放宽并告警
#TRANSCRIPT_ACCOUNT_DAILY_MAX=30
# 批量导入：python scripts/import_accounts.py douyin <cookie 文件或目录>
# 可用性巡检：python scripts/account_check.py douyin [--limit 5]
# 巡检时用的强制指定（脚本内部用，平时不用配）
#TRANSCRIPT_ACCOUNT_FORCE=
